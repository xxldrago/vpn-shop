# ================= Amnezia Panel connection =================
# The panel is assumed to run on the same host (127.0.0.1:5000).
# The API token is created in the panel: Settings -> API Tokens (prefix awp_).
PANEL_URL=http://127.0.0.1:5000
PANEL_TOKEN=awp_your_token_here

# Public URL of the shop (must match the nginx server_name / domain).
# Platega webhook will hit {SHOP_PUBLIC_URL}/webhook/callback
# e.g. SHOP_PUBLIC_URL=https://my.3set.online
SHOP_PUBLIC_URL=https://vpn.example.com

# ================= Platega =================
PLATEGA_MERCHANT_ID=your-merchant-id
PLATEGA_SECRET=your-api-key

# ================= Secret =================
# Used to sign sessions. CHANGE THIS to a long random string.
SHOP_SECRET_KEY=please-change-me-to-a-long-random-value

# ================= Telegram bot =================
# Optional. Leave empty to disable the bot. Bot is configured either here
# (env) or in the admin UI (Admin -> Settings -> Telegram bot). The admin UI
# value wins if it is non-empty.
TELEGRAM_BOT_TOKEN=

# ================= Ports (leave defaults) =================
SHOP_PORT=8080
